{
  "name": "giftlist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "audit": "npm audit --omit=optional",
    "verify": "node scripts/verify.mjs",
    "e2e": "playwright test --project=phone --project=desktop",
    "screens": "playwright test --project=screens",
    "prototype": "node scripts/build-prototype.mjs",
    "deploy:dev": "vite build && node scripts/embed-assets.mjs && wrangler deploy --config wrangler.dev.jsonc"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.16",
    "input-otp": "1.5.0",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
